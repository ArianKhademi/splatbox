# Copy to .env. These defaults match `docker compose up -d redis minio`.
# If port 9000 is taken on your machine, set MINIO_PORT (docker compose reads it from this file)
# and use the same port in S3_ENDPOINT and S3_PUBLIC_ENDPOINT below.
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- API
API_PORT=4000
# Bearer token for the demo API (also exchanged for a signed session cookie by the web app).
API_TOKEN=dev-token-change-me-0000
SESSION_SECRET=dev-session-secret-change-me-0000
DATABASE_PATH=./data/splatbox.sqlite

# --- Queue
REDIS_URL=redis://localhost:6379

# --- Object storage
# Local MinIO stand-in. For real Amazon S3: remove S3_ENDPOINT, S3_PUBLIC_ENDPOINT and
# S3_FORCE_PATH_STYLE, set S3_BUCKET / S3_REGION, and provide AWS credentials.
S3_BUCKET=splatbox
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
AWS_ACCESS_KEY_ID=splatbox
AWS_SECRET_ACCESS_KEY=splatbox-secret

# --- Worker
WORKER_CONCURRENCY=2
# Path to the Blender 4.5 LTS binary. Leave empty to use `blender` on PATH.
BLENDER_BIN=
# eevee (default) or workbench (faster, flat shading)
TURNTABLE_ENGINE=eevee
# Page the worker opens in headless Chromium to render splat turntables.
RENDER_PAGE_URL=http://localhost:5173/render.html
